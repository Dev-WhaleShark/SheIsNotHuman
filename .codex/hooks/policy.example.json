  "blockedGeneratedPaths": ["Library/", "Temp/", "obj/", "*.csproj", "*.sln", "*.slnx"],
  "formatExcludedPaths": ["Assets/Plugins/", "Packages/", "Library/", "Temp/", "obj/", "*.g.cs", "*.generated.cs", "*.designer.cs"],
  "maxLeaseMilliseconds": 300000,
  "maxFormatFiles": 16,
  "maxInputBytes": 1048576,
  "newFirstPartyUnity6Pattern": "new UnityEngine.WWW(...)",
  "maxAdditionalContextCharacters": 6000
}
