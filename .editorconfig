root = true

# 모든 텍스트 파일의 기본 규칙
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

# Unity C# 코드 규칙
[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_new_line_before_open_brace = all
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true
csharp_style_namespace_declarations = block_scoped:silent
csharp_style_prefer_braces = true:silent

# Unity 직렬화 필드를 제외한 private 인스턴스 필드는 _camelCase를 사용한다.
resharper_csharp_naming_rule.private_instance_fields = _+aaBb

# Rider에서 외부 플러그인 코드를 검사 대상에서 제외한다.
[Assets/Plugins/**/*.cs]
generated_code = true

# Unity JSON 계열 파일
[*.{asmdef,asmref,inputactions,json}]
indent_size = 2

# Unity 직렬화 파일은 Git 설정과 동일하게 LF를 사용한다.
[*.{anim,asset,controller,mat,meta,prefab,renderTexture,unity}]
end_of_line = lf
indent_size = 2

# Markdown의 의도적인 줄 끝 공백을 보존한다.
[*.md]
trim_trailing_whitespace = false
